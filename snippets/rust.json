      "    ) -> Option<LoadingWidgets> {",
      "        relm4::view! {",
      "            #[local_ref]",
      "            root {",
      "                #[name(spinner)]",
      "                gtk::Spinner {",
      "                    start: ()",
      "                }",
      "            }",
      "        }",
      "        Some(LoadingWidgets::new(root, spinner))",
      "    }",
      "",
      "    async fn init_model(",
      "        init: Self::Init,",
      "        _index: &DynamicIndex,",
      "        _sender: AsyncFactorySender<Self>,",
      "    ) -> Self {",
      "        Self {",
      "        ",
      "        }",
      "    }",
      "",
      "    fn init_widgets(",
      "        &mut self,",
      "        _index: &DynamicIndex,",
      "        root: Self::Root,",
      "        _returned_widget: &<Self::ParentWidget as FactoryView>::ReturnedWidget,",
      "        sender: AsyncFactorySender<Self>,",
      "    ) -> Self::Widgets {",
      "        let widgets = view_output!();",
      "        widgets",
      "    }",
      "",
      "    async fn update(",
      "        &mut self,",
      "        message: Self::Input,",
      "        sender: AsyncFactorySender<Self>,",
      "    ) {",
      "        match message {}",
      "    }",
      "",
      "}"
